{% extends 'base.html.twig' %}

{% block title %}Liste des categories
{% endblock %}

{% block stylesheets %}

	<style>
		h1 {
			color: purple;
		}
	</style>

{% endblock %}

{% block body %}
	<div class="example-wrapper">
		<h1>Fiche des catégories</h1>
		<p>
			{{category.name|upper }}
		</p>

		<form action="{{ path('app_category_delete', {'id':category.id}) }}" 
			method="post"
			onsubmit="return confirm('êtes-vous sûr de vouloir supprimer ?')">

			<input type="hidden" name="_method" value="DELETE">

			<button>Supprimer</button>
		</form>
	<div>

{% endblock %}
